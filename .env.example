ENVIRONMENT=development
DEMO_MODE=true
DATABASE_URL=postgresql+asyncpg://meraipo:local-development-only@localhost:5432/meraipo
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=meraipo
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=meraipo
PUBLIC_ORIGIN=http://localhost:3000
SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
SESSION_HOURS=8
CACHE_TTL=60
GMP_TTL_HOURS=12
PRICE_TTL_HOURS=72
PROVIDER_MODE=manual
STORAGE_BACKEND=local
STORAGE_PATH=./work/documents
S3_BUCKET=
S3_ENDPOINT=
IPO_REFRESH_MINUTES=240
RESULTS_REFRESH_MINUTES=1440
DOCUMENT_REFRESH_MINUTES=1440
GMP_REFRESH_MINUTES=60
EOD_HOUR_IST=18
# Production market ingestion is disabled until approved feed access is configured.
CRON_SECRET=
# Stable 32+ character secret used only to encrypt provider credentials stored by MeraAdmin.
CONFIG_ENCRYPTION_KEY=
MARKET_SCHEDULER_ENABLED=false
MARKET_FEEDS_JSON={}
MARKET_SCHEDULER_DRIVER=celery
EXCHANGE_DIRECT_ENABLED=false
NSE_SUBSCRIPTION_CATEGORIES_ENABLED=true
# Optional reviewed native IPO/results discovery mappings; see docs/exchange-pipeline.md.
EXCHANGE_SOURCES_JSON=[]
BSE_IPO_ISSUES_JSON=[]
# Confirm the exchange holiday calendar annually; comma-separated YYYY-MM-DD dates.
TRADING_CALENDAR_YEAR=0
TRADING_HOLIDAYS=

# IPO discovery strategy: exchange, ipoalerts, or versioned feed
IPO_DATA_PROVIDER=ipoweb
IPOALERTS_API_KEY=
IPOALERTS_PAGE_SIZE=3

# Daily closing files: backend-only JSON; see docs/bhavcopy.md and the verified NSE example.
BHAVCOPY_SOURCES_JSON={}
BHAVCOPY_STORAGE_PATH=./work/bhavcopies

# Optional verified IPO email subscriptions (off until SES is configured).
EMAIL_FROM=alerts@meraipo.com
EMAIL_TOKEN_SECRET=
EMAIL_SEND_HOUR_IST=8
EMAIL_OPEN_TRACKING_ENABLED=false
EMAIL_EVENT_RETENTION_DAYS=400
SES_REGION=ap-south-1
SES_CONFIGURATION_SET=meraipo-ipo-alerts
SES_SNS_TOPIC_ARN=
# AWS credentials use the SDK credential chain / production IAM role.
# Google JSON key must be mounted read-only in API container, never under public/.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_FILE=
GA4_MEASUREMENT_ID=G-ZYEKCCV3J5

# Bulk sending requires this permission AND the persistent admin control/readiness.
IPO_EMAIL_SENDING_ENABLED=false
EMAIL_FROM_NAME=MeraIPO Alerts
EMAIL_BATCH_SIZE=20
EMAIL_MAX_PER_SECOND=1
EMAIL_CATCHUP_HOURS=4
EMAIL_MAX_ATTEMPTS=5
EMAIL_UNSUBSCRIBE_DAYS=400
